# Build upstream drivers now; enabling a device in the guest DTB still requires
# admitted MMIO/IRQ/DMA ownership. This is not a passthrough authorization.
CONFIG_ARCH_BCM2835=y
CONFIG_PCIE_BRCMSTB=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_BRCMSTB=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_MACB=y
CONFIG_PHYLIB=y
CONFIG_BROADCOM_PHY=y
CONFIG_COMMON_CLK=y
CONFIG_RESET_CONTROLLER=y
CONFIG_PINCTRL=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIOLIB=y
