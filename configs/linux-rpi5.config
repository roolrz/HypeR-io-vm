# Pi 5 device support. Guest DT exposes only devices explicitly assigned by HypeR.
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y
CONFIG_COMMON_CLK=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_BRCMSTB=y
CONFIG_PINCTRL_BCM2712=y
CONFIG_GPIOLIB=y
CONFIG_OF_GPIO=y
CONFIG_GPIO_BRCMSTB=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_BRCMSTB=y

# The whole RP1 PCI function is assigned. Native owns the physical PCIe bridge
# and MSI-X transport; Linux enumerates RP1 and owns its peripheral drivers.
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_CADENCE=y
CONFIG_MACB=y
CONFIG_BROADCOM_PHY=y
CONFIG_PCI_MSI=y
CONFIG_PCI_QUIRKS=y
CONFIG_OF_OVERLAY=y
CONFIG_MISC_RP1=y
CONFIG_COMMON_CLK_RP1=y
CONFIG_PINCTRL_RP1=y
# The upstream RP1 platform drivers use regmap-MMIO without selecting it.
# SYSCON provides the standard selector; no syscon device is exposed by HypeR.
CONFIG_MFD_SYSCON=y
CONFIG_REGMAP_MMIO=y
